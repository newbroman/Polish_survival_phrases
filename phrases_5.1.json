      "category": "Counting",
      "pl": "Dwa",
      "en": "Two",
      "level": 5.1,
      "emoji": "2️⃣",
      "note": "Feminine and neuter are 'dwie' (dwie kawy); with people, 'dwaj' or 'dwóch' appear."
