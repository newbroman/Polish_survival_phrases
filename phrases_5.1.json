    {
      "id": "5.1-07",
      "category": "Counting",
      "pl": "Dwadzieścia",
      "en": "Twenty",
      "level": 5.1,
      "emoji": "2️⃣",
      "note": "Tens up to 40 end -ścia/-ści (dwadzieścia, trzydzieści, czterdzieści); from 50 it is -dziesiąt."
