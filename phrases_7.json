{
  "level": 7,
  "description": "Shopping & Money - Purchases & Payment",
  "tier": "SURVIVAL",
  "phrases": [
    {
      "id": "7-01",
      "category": "Prices & Payment",
      "pl": "Ile to kosztuje?",
      "en": "How much is this?",
      "level": 7,
      "gender": null,
      "emoji": "💰",
      "note": "Say 'to' while pointing. 'Ile kosztują?' for plural items like shoes."
    },
    {
      "id": "7-02",
      "category": "Prices & Payment",
      "pl": "Za drogie",
      "en": "Too expensive",
      "level": 7,
      "gender": null,
      "emoji": "😬",
      "note": "'Za' + adjective means 'too': za drogie, za duże. 'Drogie' agrees with the neuter 'to'."
    },
    {
      "id": "7-03",
      "category": "Prices & Payment",
      "pl": "Za dużo",
      "en": "Too much",
      "level": 7,
      "gender": null,
      "emoji": "✋",
      "note": "'Za dużo' = too much; 'za mało' = too little. Handy for stopping a server pouring or weighing more."
    },
    {
      "id": "7-04",
      "category": "Prices & Payment",
      "pl": "Czy mogę zapłacić kartą?",
      "en": "Can I pay by card?",
      "level": 7,
      "gender": null,
      "emoji": "💳",
      "note": "Instrumental case: 'kartą' (by card). Contactless and BLIK are widely accepted in Poland."
    },
    {
      "id": "7-05",
      "category": "Prices & Payment",
      "pl": "Gotówka",
      "en": "Cash",
      "level": 7,
      "gender": null,
      "emoji": "💵",
      "note": "'Gotówką' (by cash) after 'zapłacić'. Say 'Płacę gotówką' to pay cash."
    },
    {
      "id": "7-06",
      "category": "Prices & Payment",
      "pl": "Karta",
      "en": "Card",
      "level": 7,
      "gender": null,
      "emoji": "💳",
      "note": "Say 'Kartą' for 'by card'. Often asked: 'Kartą czy gotówką?'"
    },
    {
      "id": "7-07",
      "category": "Prices & Payment",
      "pl": "Bankomat",
      "en": "ATM",
      "level": 7,
      "gender": null,
      "emoji": "🏧",
      "note": "Stress falls on 'ko' (bahn-KOH-maht). Prefer ATMs attached to banks to avoid higher fees."
    },
    {
      "id": "7-08",
      "category": "Prices & Payment",
      "pl": "Gdzie jest bankomat?",
      "en": "Where is the ATM?",
      "level": 7,
      "gender": null,
      "emoji": "📍",
      "note": "'Gdzie jest...?' + nominative. Say 'bankomat' as one word, stress on 'ko'."
    },
    {
      "id": "7-09",
      "category": "Prices & Payment",
      "pl": "Reszta",
      "en": "Change (money back)",
      "level": 7,
      "gender": null,
      "emoji": "🪙",
      "note": "Also means 'the rest'. In shops, 'reszta' is the change you get back."
    },
    {
      "id": "7-10",
      "category": "Prices & Payment",
      "pl": "Proszę resztę",
      "en": "Change, please",
      "level": 7,
      "gender": null,
      "emoji": "🙏",
      "note": "Literally 'The change, please'. Staff normally hand it over without being asked."
    },
    {
      "id": "7-11",
      "category": "Prices & Payment",
      "pl": "Reszty nie trzeba",
      "en": "Keep the change",
      "level": 7,
      "gender": null,
      "emoji": "🎁",
      "note": "Literally 'Change not needed'. Tipping lightly (about 10%) is normal in restaurants."
    },
    {
      "id": "7-12",
      "category": "Prices & Payment",
      "pl": "Paragon",
      "en": "Receipt",
      "level": 7,
      "gender": null,
      "emoji": "🧾",
      "note": "Stress on 'ra': pa-RA-gon. Keep it for returns (zwrot). Ask for a 'faktura' if you need a VAT invoice."
    },
    {
      "id": "7-13",
      "category": "Prices & Payment",
      "pl": "Paragon, proszę",
      "en": "Receipt, please",
      "level": 7,
      "gender": null,
      "emoji": "🧾",
      "note": "'Poproszę paragon' is a very common alternative. Request a VAT invoice with 'fakturę'."
    },
    {
      "id": "7-14",
      "category": "Prices & Payment",
      "pl": "Ile płacę?",
      "en": "How much do I pay?",
      "level": 7,
      "gender": null,
      "emoji": "🧮",
      "note": "Verb 'płacić' (to pay): 'płacę' is first person singular. Useful at a till or a taxi."
    },
    {
      "id": "7-15",
      "category": "Prices & Payment",
      "pl": "Razem",
      "en": "Total / Together",
      "level": 7,
      "gender": null,
      "emoji": "➕",
      "note": "'Razem' means both 'in total' and 'together'. Also: 'Razem czy osobno?' (together or separate?)."
    },
    {
      "id": "7-16",
      "category": "Prices & Payment",
      "pl": "To wszystko",
      "en": "That's all",
      "level": 7,
      "gender": null,
      "emoji": "✅",
      "note": "Literally 'This everything'. Say it at the till when you've finished ordering."
    },
    {
      "id": "7-17",
      "category": "Prices & Payment",
      "pl": "Wezmę to",
      "en": "I'll take it",
      "level": 7,
      "gender": null,
      "emoji": "🛍️",
      "note": "'Wezmę' is the future of 'wziąć' (to take). Perfective, so it means 'I will take it'."
    },
    {
      "id": "7-18",
      "category": "Prices & Payment",
      "pl": "Nie, dziękuję",
      "en": "No, thank you",
      "level": 7,
      "gender": null,
      "emoji": "🙅",
      "note": "Polite refusal to sales offers, e.g. when asked about a bag or loyalty card."
    },
    {
      "id": "7-19",
      "category": "Prices & Payment",
      "pl": "Tylko patrzę",
      "en": "Just looking",
      "level": 7,
      "gender": null,
      "emoji": "👀",
      "note": "Reply to 'Czy mogę w czymś pomóc?' (Can I help?). Staff will usually leave you alone."
    },
    {
      "id": "7-20",
      "category": "Prices & Payment",
      "pl": "Czy jest zniżka?",
      "en": "Is there a discount?",
      "level": 7,
      "gender": null,
      "emoji": "🏷️",
      "note": "'Zniżka' is a discount; 'rabat' and 'promocja' (sale) also appear on signs. 'Przecena' = reduced price."
    },
    {
      "id": "7-21",
      "category": "Shopping",
      "pl": "Gdzie mogę kupić...?",
      "en": "Where can I buy...?",
      "level": 7,
      "gender": null,
      "emoji": "🛒",
      "note": "After 'kupić' (to buy), use the accusative: 'Gdzie mogę kupić chleb?'"
    },
    {
      "id": "7-22",
      "category": "Shopping",
      "pl": "Szukam...",
      "en": "I'm looking for...",
      "level": 7,
      "gender": null,
      "emoji": "🔍",
      "note": "Takes the genitive: 'Szukam apteki' (a pharmacy), 'Szukam bankomatu'. Feminine -a becomes -y."
    },
    {
      "id": "7-23",
      "category": "Shopping",
      "pl": "Czy macie...?",
      "en": "Do you have...?",
      "level": 7,
      "gender": null,
      "emoji": "❓",
      "note": "'Macie' is plural 'you', normal for a shop. After 'mieć' use the accusative: 'Czy macie wodę?'"
    },
    {
      "id": "7-24",
      "category": "Shopping",
      "pl": "W jakim rozmiarze?",
      "en": "What size?",
      "level": 7,
      "gender": null,
      "emoji": "📏",
      "note": "Locative: 'w jakim rozmiarze'. Clothing sizes are EU/continental, e.g. 38, 40, M, L."
    },
    {
      "id": "7-25",
      "category": "Shopping",
      "pl": "Mały",
      "en": "Small",
      "level": 7,
      "gender": null,
      "emoji": "🤏",
      "note": "Masculine form. Feminine 'mała', neuter 'małe'. 'ł' sounds like English 'w'."
    },
    {
      "id": "7-26",
      "category": "Shopping",
      "pl": "Średni",
      "en": "Medium",
      "level": 7,
      "gender": null,
      "emoji": "👕",
      "note": "Masculine form. Feminine 'średnia', neuter 'średnie'. Clothing is usually just S, M, L."
    },
    {
      "id": "7-27",
      "category": "Shopping",
      "pl": "Duży",
      "en": "Large",
      "level": 7,
      "gender": null,
      "emoji": "🧥",
      "note": "Masculine form. Feminine 'duża', neuter 'duże'. Stress on the first syllable: DOO-zhee."
    },
    {
      "id": "7-28",
      "category": "Shopping",
      "pl": "Za mały",
      "en": "Too small",
      "level": 7,
      "gender": null,
      "emoji": "🤏",
      "note": "'Za' + the form matching the item: za mały (masculine), za mała (feminine), za małe (neuter/plural)."
    },
    {
      "id": "7-29",
      "category": "Shopping",
      "pl": "Za duży",
      "en": "Too big",
      "level": 7,
      "gender": null,
      "emoji": "🧥",
      "note": "'Za duży' for a masculine item, 'za duża' for a feminine one, 'za duże' for plural shoes."
    },
    {
      "id": "7-30",
      "category": "Shopping",
      "pl": "Czy mogę przymierzyć?",
      "en": "Can I try it on?",
      "level": 7,
      "gender": null,
      "emoji": "👗",
      "note": "'Przymierzyć' is perfective (to try on once). 'Mogę' + infinitive means 'may I'."
    },
    {
      "id": "7-31",
      "category": "Shopping",
      "pl": "Gdzie jest przymierzalnia?",
      "en": "Where is the fitting room?",
      "level": 7,
      "gender": null,
      "emoji": "🚪",
      "note": "'Przymierzalnia' is the fitting room. Some stores post a limit of items per visit."
    },
    {
      "id": "7-32",
      "category": "Shopping",
      "pl": "Czy macie to w innym kolorze?",
      "en": "Do you have this in another colour?",
      "level": 7,
      "gender": null,
      "emoji": "🎨",
      "note": "'W innym kolorze' is locative (in another colour). 'Inny' = other, different."
    },
    {
      "id": "7-33",
      "category": "Shopping",
      "pl": "Czy macie to w innym rozmiarze?",
      "en": "Do you have this in another size?",
      "level": 7,
      "gender": null,
      "emoji": "📐",
      "note": "'W innym rozmiarze' is locative. Staff may answer 'Sprawdzę' (I'll check)."
    },
    {
      "id": "7-34",
      "category": "Shopping",
      "pl": "To pasuje",
      "en": "This fits",
      "level": 7,
      "gender": null,
      "emoji": "👍",
      "note": "'Pasować' = to fit or suit. 'To mi pasuje' means 'This suits me'."
    },
    {
      "id": "7-35",
      "category": "Shopping",
      "pl": "To nie pasuje",
      "en": "This doesn't fit",
      "level": 7,
      "gender": null,
      "emoji": "👎",
      "note": "Negate with 'nie' directly before the verb. Add 'jest za ciasne' for 'too tight'."
    },
    {
      "id": "7-36",
      "category": "Shopping",
      "pl": "Czy mogę to zwrócić?",
      "en": "Can I return this?",
      "level": 7,
      "gender": null,
      "emoji": "↩️",
      "note": "'Zwrócić' means to return. Online purchases have a 14-day right of return in Poland."
    },
    {
      "id": "7-37",
      "category": "Shopping",
      "pl": "Torba, proszę",
      "en": "Bag, please",
      "level": 7,
      "gender": null,
      "emoji": "🛍️",
      "note": "Shops charge a small fee for plastic bags. 'Reklamówka' is a carrier bag; 'Torbę poproszę' is more natural."
    },
    {
      "id": "7-38",
      "category": "Shopping",
      "pl": "Sklep",
      "en": "Shop / Store",
      "level": 7,
      "gender": null,
      "emoji": "🏪",
      "note": "Plural 'sklepy'. Most Polish shops close or restrict hours on Sundays (trading ban)."
    },
    {
      "id": "7-39",
      "category": "Shopping",
      "pl": "Supermarket",
      "en": "Supermarket",
      "level": 7,
      "gender": null,
      "emoji": "🛒",
      "note": "Stress is on the second-to-last syllable: su-per-MAR-ket. Chains include Biedronka and Lidl."
    },
    {
      "id": "7-40",
      "category": "Shopping",
      "pl": "Apteka",
      "en": "Pharmacy",
      "level": 7,
      "gender": null,
      "emoji": "💊",
      "note": "Look for the green cross. Open late: 'apteka całodobowa' means 24-hour pharmacy."
    },
    {
      "id": "7-41",
      "category": "Money & Numbers",
      "pl": "Złoty",
      "en": "Zloty (Polish currency)",
      "level": 7,
      "gender": null,
      "emoji": "🇵🇱",
      "note": "Abbreviated PLN or zł. Masculine noun; plural 'złote' (2-4), then 'złotych' (5+)."
    },
    {
      "id": "7-42",
      "category": "Money & Numbers",
      "pl": "Grosz",
      "en": "Grosz (Polish cent)",
      "level": 7,
      "gender": null,
      "emoji": "🪙",
      "note": "100 groszy = 1 złoty. Plural: 'grosze' (2-4), 'groszy' (5+)."
    },
    {
      "id": "7-43",
      "category": "Money & Numbers",
      "pl": "Pięć złotych",
      "en": "Five zloty",
      "level": 7,
      "gender": null,
      "emoji": "5️⃣",
      "note": "From 5 up, nouns take the genitive plural: 'złotych', not 'złote'."
    },
    {
      "id": "7-44",
      "category": "Money & Numbers",
      "pl": "Dziesięć złotych",
      "en": "Ten zloty",
      "level": 7,
      "gender": null,
      "emoji": "🔟",
      "note": "Genitive plural 'złotych' after 5 and up. Say 'dziesięć' as JEH-shench."
    },
    {
      "id": "7-45",
      "category": "Money & Numbers",
      "pl": "Dwadzieścia złotych",
      "en": "Twenty zloty",
      "level": 7,
      "gender": null,
      "emoji": "💵",
      "note": "Hard to say: dvah-JEHSH-chah. Pattern: 'dwadzieścia jeden' (21) puts the units second."
    },
    {
      "id": "7-46",
      "category": "Money & Numbers",
      "pl": "Pięćdziesiąt złotych",
      "en": "Fifty zloty",
      "level": 7,
      "gender": null,
      "emoji": "💵",
      "note": "Has two nasal vowels: 'ę' and 'ą'. Shops may prefer smaller notes for small purchases."
    },
    {
      "id": "7-47",
      "category": "Money & Numbers",
      "pl": "Sto złotych",
      "en": "One hundred zloty",
      "level": 7,
      "gender": null,
      "emoji": "💯",
      "note": "After 'sto' the genitive plural 'złotych' follows. Say 'sto' as one syllable."
    },
    {
      "id": "7-48",
      "category": "Money & Numbers",
      "pl": "Jeden",
      "en": "One",
      "level": 7,
      "gender": null,
      "emoji": "1️⃣",
      "note": "Masculine form. Feminine 'jedna', neuter 'jedno': 'jeden chleb', 'jedna kawa'."
    },
    {
      "id": "7-49",
      "category": "Money & Numbers",
      "pl": "Dwa",
      "en": "Two",
      "level": 7,
      "gender": null,
      "emoji": "2️⃣",
      "note": "Masculine and neuter form. Feminine is 'dwie': 'dwa piwa' but 'dwie kawy'."
    },
    {
      "id": "7-50",
      "category": "Money & Numbers",
      "pl": "Trzy",
      "en": "Three",
      "level": 7,
      "gender": null,
      "emoji": "3️⃣",
