    },
    {
      "id": "7-53",
      "category": "Money & Numbers",
      "pl": "Dziesięć",
      "en": "Ten",
      "level": 7,
      "gender": null,
      "emoji": "🔟",
      "note": "Sounds like JEH-shench. Takes the genitive plural: 'dziesięć złotych'."
    },
    {
      "id": "7-54",
      "category": "Money & Numbers",
      "pl": "Dwadzieścia",
      "en": "Twenty",
      "level": 7,
      "gender": null,
      "emoji": "2️⃣",
      "note": "Pattern: 'dwadzieścia jeden' (21) puts the units second, unlike English order."
    },
    {
      "id": "7-55",
      "category": "Money & Numbers",
      "pl": "Sto",
      "en": "One hundred",
      "level": 7,
      "gender": null,
      "emoji": "💯",
      "note": "No change for gender. 200 is 'dwieście', 300 is 'trzysta'."
    },
