    },
    {
      "id": "2-18",
      "category": "Medical & Health",
      "pl": "Mam alergię",
      "en": "I have an allergy",
      "level": 2,
      "gender": null,
      "emoji": "🤧",
      "note": "Takes the accusative case ('alergia' becomes 'alergię')."
