      "en": "My head hurts",
      "level": 2,
      "gender": null,
      "emoji": "🤕",
      "note": "Literally: 'The head hurts me'. 'Boli' (it hurts) + 'mnie' (me) + body part."
    },
    {
      "id": "2-15",
      "category": "Medical & Health",
      "pl": "Boli mnie brzuch",
      "en": "My stomach hurts",
      "level": 2,
      "gender": null,
      "emoji": "🤢",
      "note": "Literally: 'The stomach hurts me'."
    },
    {
      "id": "2-16",
      "category": "Medical & Health",
      "pl": "Mam gorączkę",
      "en": "I have a fever",
      "level": 2,
      "gender": null,
      "emoji": "🌡️",
      "note": "'Mam' (I have) takes the accusative case ('gorączka' -> 'gorączkę')."
