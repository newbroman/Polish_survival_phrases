      "category": "Emergencies",
      "pl": "Gdzie jest szpital?",
      "en": "Where is the hospital?",
      "level": 2,
      "gender": null,
      "emoji": "🏥",
      "note": "'Gdzie jest' (Where is) is your master phrase for finding locations."
    },
    {
      "id": "2-10",
      "category": "Emergencies",
      "pl": "Gdzie jest apteka?",
      "en": "Where is the pharmacy?",
      "level": 2,
      "gender": null,
      "emoji": "⚕️",
      "note": "Look for a glowing green cross to find an 'apteka'."
    },
    {
      "id": "2-11",
      "category": "Problems & Police",
      "pl": "To pilne!",
      "en": "It's urgent!",
      "level": 2,
      "gender": null,
      "emoji": "🚨",
      "note": "'Pilne' is an adjective meaning urgent or pressing."
    },
    {
