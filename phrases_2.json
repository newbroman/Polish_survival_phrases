      "category": "Medical & Health",
      "pl": "Potrzebuję leków",
      "en": "I need medicine",
      "level": 2,
      "gender": null,
      "emoji": "💊",
      "note": "'Lek' is medicine. 'Leków' is the Genitive plural form required by 'Potrzebuję'."
    },
    {
      "id": "2-20",
      "category": "Medical & Health",
      "pl": "Proszę wezwać pomoc",
      "en": "Please call for help",
      "level": 2,
      "gender": null,
      "emoji": "📞",
      "note": "A very formal and urgent way to ask a bystander to call emergency services."
    },
